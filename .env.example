# Kathix configuration. Copy to `.env` and fill in only what you use.
# Keys can also be added from the Studio's setup screen; those are stored
# in an encrypted settings file inside the data folder, never in plain text.

# --- Server -----------------------------------------------------------------
# Port and host for the Studio. The server binds to localhost by default.
KATHIX_PORT=4319
KATHIX_HOST=127.0.0.1
# Folder holding the database, encrypted settings and key file (git-ignored).
KATHIX_DATA_DIR=./data

# --- Hosted model providers (any one is enough) ------------------------------
# Anthropic (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI. Get a key at https://platform.openai.com
OPENAI_API_KEY=
# Google Gemini. Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint (Groq, OpenRouter, Together, LM Studio ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- Local model runtime ------------------------------------------------------
# Ollama's default address. Used for the local fallback when it answers.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Adaption custom voice model (optional) ----------------------------------
# Key from https://adaptionlabs.ai/app/settings?tab=api_keys
ADAPTION_API_KEY=
# Model id to use as the creator's voice writer (hosted id or stack:<slug>).
ADAPTION_VOICE_MODEL=
# REST base; only change if Adaption tells you to.
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai

# --- Tests only ---------------------------------------------------------------
# Enables the deterministic mock provider. Never set this for real use.
KATHIX_MOCK_PROVIDER=
